# Opção recomendada — Resend (funciona no Railway)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_TO=contato@acurabrasil.org
CONTACT_FROM=contato@acurabrasil.org
# Link do grupo WhatsApp da Masterclass EFT Avatar (exibido no admin após confirmar inscrição)
MASTERCLASS_EFT_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/EAxjeI6VZZS7nIyCEDPazh
# Destinatário do formulário de solicitud SOS Venezuela (triaje)
SOS_VENEZUELA_TO=contato@acurabrasil.org
# Anti-spam por e-mail após envio bem-sucedido (ms). Use 0 para desativar (dev/testes).
SOS_INTAKE_RATE_LIMIT_MS=20000

# Admin SOS Venezuela (painel interno em /admin/)
ADMIN_USERNAME=admin
# Dev: senha em texto (nunca use em produção)
ADMIN_PASSWORD=
# Produção (obrigatório): hash scrypt gerado via stdin — evita vazar no shell history:
#   node scripts/hash-password.js
#   (digite a senha e pressione Enter; copie a linha salt:hash para ADMIN_PASSWORD_HASH)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=     # 32+ caracteres aleatórios (obrigatório em produção)
# Criptografia AES-256-GCM dos campos sensíveis de saúde em sos_intakes (LGPD Art. 5º II).
# Gerar: node scripts/generate-encryption-key.js
# Guardar cópia offline (gerenciador de senhas) — perder a chave torna os dados irrecuperáveis.
ENCRYPTION_KEY=
DATA_PATH=./data/acura-sos.db
# Railway produção: montar Volume em /data e usar DATA_PATH=/data/acura-sos.db
# Google Analytics 4 (substitua pelo ID real da propriedade GA4)
GA4_MEASUREMENT_ID=G-ZXE5T1VCGS

# Host canônico (redirect 301 de acurabrasil.org)
CANONICAL_HOST=www.acurabrasil.org

# URL canônica para links UTM absolutos (opcional)
SITE_URL=https://www.acurabrasil.org

# WhatsApp SOS (E.164 digits, no +) — Doctor8 WABA inbox +49 174 9803699
# SOS_CONFIG whatsapp_number in SQLite is migrated to 491749803699 on deploy (migration v11).

# Proteção do painel /admin e /api/admin (obrigatório em produção — fail-closed → 404)
#
# Modo preferido — Cloudflare Access (IPs dinâmicos, bloqueia *.up.railway.app):
#   Zero Trust → Access → Applications → sua app → Application Audience (AUD) Tag
#   Team domain: Zero Trust → Settings → Team domain (ex.: acurabrasil.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=acurabrasil.cloudflareaccess.com
CF_ACCESS_AUD=
#
# Modo legado — allowlist de IP (opcional; pode combinar com CF Access: JWT válido OU IP na lista):
# ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.5
#
# Teste manual (com CF Access ativo em produção, deve retornar HTTP 404):
#   curl -i https://www.acurabrasil.org/admin/
#   curl -i https://www.acurabrasil.org/api/admin/me
#   curl -i https://SEU-APP.up.railway.app/admin/
# (sem header Cf-Access-Jwt-Assertion — simula bypass ou acesso direto ao Railway)

# Doctor8 — verificação de e-mail cadastrado + sync de intakes SOS (Sprint B)
# Contrato acordado com equipe Doctor8:
#   POST /api/integrations/check-email  Authorization: Bearer <token>
#   POST /api/integrations/acura/intakes  (push após submit do formulário)
#   PATCH /api/integrations/acura/intakes/:protocolo  (atualizações de triagem/cliques)
#   GET  /api/integrations/acura/volunteers  (diretório público de voluntários)
#   Body check-email: { "email": "paciente@exemplo.com" }
#   Resposta mínima: { "registered": true | false }
#   Resposta recomendada (masterclass admin):
#   {
#     "registered": true,
#     "approved": true,
#     "approvalStatus": "approved",
#     "documentsVerified": true,
#     "user": {
#       "id": "...", "name": "...", "email": "...", "phone": "...",
#       "role": "...", "status": "active",
#       "approved": true, "approvalStatus": "approved", "documentsVerified": true,
#       "profileUrl": "https://app.doctor8.org/..."
#     }
#   }
#   approvalStatus: approved | pending | rejected
# Staging (quando disponível): DOCTOR8_API_BASE_URL=https://staging.doctor8.org
DOCTOR8_API_BASE_URL=https://app.doctor8.org
DOCTOR8_API_KEY=
DOCTOR8_EMAIL_CHECK_PATH=/api/integrations/check-email
DOCTOR8_EMAIL_CHECK_METHOD=POST
# Lookup rico (perfil + aprovação). Se 404, o Acura usa check-email.
DOCTOR8_LOOKUP_PATH=/api/integrations/lookup-user
DOCTOR8_REGISTERED_FIELD=registered
DOCTOR8_API_TIMEOUT_MS=12000
# Cache da listagem de voluntários no servidor (ms). Padrão: 300000 (5 min)
# DOCTOR8_VOLUNTEERS_CACHE_MS=300000
# Limite máximo de profissionais retornados da Doctor8 (opcional)
# DOCTOR8_VOLUNTEERS_LIMIT=200

# PayPal (developer.paypal.com → Apps & Credentials → Live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Use "sandbox" para testes; omita ou use "live" em produção
PAYPAL_MODE=live
# PayPal webhook (opcional — quando webhooks forem ativados)
# PAYPAL_WEBHOOK_ID=

# Enquanto o domínio não estiver verificado no Resend, use temporariamente:
# CONTACT_FROM=onboarding@resend.dev
# CONTACT_TO=diegoalbs@acurabrasil.org
